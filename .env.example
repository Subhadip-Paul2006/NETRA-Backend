# NETRA Local Development Environment Configuration
# Copy this file to .env for local testing (Never commit .env to source control)

# Operational Environment (development | staging | production)
NETRA_ENV=development

# Logging Verbosity (trace | debug | info | warn | error)
NETRA_LOG_LEVEL=debug

# Output Formatting (human | json)
NETRA_LOG_FORMAT=human

# Control API Endpoint (For local/mock testing)
NETRA_SERVER_URL=https://api.netra.local:8443

# Local SQLite Database Path (Optional override)
# Defaults to project-local tmp/agent.db during development
NETRA_LOCAL_DB_PATH=tmp/agent.db

# Heartbeat Interval (Seconds)
NETRA_HEARTBEAT_INTERVAL=15

# Disable ANSI Colors (0 = colored, 1 = plain text)
NO_COLOR=0
