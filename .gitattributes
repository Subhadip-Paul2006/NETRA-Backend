# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force specific line endings for code and config
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.lock text eol=lf
